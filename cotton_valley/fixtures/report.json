  "modified": "2025-12-08 03:43:01.961224",
  "module": "Cotton Valley",
  "name": "Last Month Orders Summary CV",
  "prepared_report": 0,
  "query": "SELECT\r\n    company AS \"Company:Link/Company:150\",\r\n    name AS \"Sales Order:Link/Sales Order:150\",\r\n    transaction_date AS \"Order Date:Date:120\",\r\n    customer AS \"Customer:Link/Customer:150\",\r\n    grand_total AS \"Total Amount:Currency:120\",\r\n    status AS \"Status::100\"\r\nFROM `tabSales Order`\r\nWHERE\r\n    docstatus = 1\r\n    AND company = 'Cotton Valley'\r\n    AND transaction_date >= DATE_FORMAT(DATE_SUB(CURDATE(), INTERVAL 1 MONTH), '%%Y-%%m-01')\r\n    AND transaction_date < DATE_FORMAT(CURDATE(), '%%Y-%%m-01')\r\nORDER BY transaction_date DESC\r\n",
  "ref_doctype": "Sales Order",
