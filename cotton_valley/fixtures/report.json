  "modified": "2025-12-08 01:17:19.217406",
  "module": "Cotton Valley",
  "name": "Best Selling Products CV",
  "prepared_report": 0,
  "query": "SELECT\r\n    SO.company AS company,\r\n    SOI.item_code AS item_code,\r\n    SOI.item_name AS item_name,\r\n    SUM(SOI.qty) AS total_quantity_sold,\r\n    SUM(SOI.qty * SOI.base_rate) AS total_sales_value\r\nFROM\r\n    `tabSales Order Item` SOI\r\nJOIN\r\n    `tabSales Order` SO ON SOI.parent = SO.name\r\nWHERE\r\n    SO.docstatus = 1  -- Only consider submitted/confirmed orders\r\n    AND SO.company = 'Cotton Valley'\r\nGROUP BY\r\n    SOI.item_code,\r\n    SOI.item_name,\r\n    SO.company\r\nORDER BY\r\n    total_quantity_sold DESC, total_sales_value DESC\r\nLIMIT 20;\r\n",
  "ref_doctype": "Sales Order",
  "reference_report": null,
  "report_name": "Best Selling Products CV",
  "report_script": null,
